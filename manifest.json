{
  "manifest_version": 3,
  "name": "IUH Dashboard",
  "version": "5.2",
  "description": "Giải pháp thay thế IUH Dashboard",
  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["*://sv.iuh.edu.vn/*"],
      "js": ["bridge.js", "autologin.js"]
    },
    {
      "matches": ["*://sv.iuh.edu.vn/*"],
      "js": ["tf.min.js", "content.js"],
      "world": "MAIN"
    },
    {
      "matches": ["*://sv.iuh.edu.vn/*"],
      "js": ["survey_agent.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["tfjs_model/*", "tf.min.js"],
      "matches": ["*://sv.iuh.edu.vn/*"]
    }
  ]
}