{
  "manifest_version": 3,
  "name": "IUH Dashboard",
  "version": "2.1.0",
  "description": "Giải pháp thay thế IUH Dashboard",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://sv.iuh.edu.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["*://sv.iuh.edu.vn/*"],
      "js": ["bridge.js", "autologin.js"]
    },
    {
      "matches": ["*://sv.iuh.edu.vn/*"],
      "js": ["tf.min.js", "content.js"],
      "world": "MAIN"
    },
    {
      "matches": ["*://sv.iuh.edu.vn/*"],
      "js": ["survey_agent.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["tfjs_model/*", "tf.min.js"],
      "matches": ["*://sv.iuh.edu.vn/*"]
    },
    {
      "resources": ["dashboard/*"],
      "matches": ["<all_urls>"]
    }
  ]
}